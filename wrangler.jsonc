{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "outperform",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "OPENROUTER_MODEL": "deepseek/deepseek-v4-flash",
    "OPENROUTER_CHALLENGER_MODEL": "qwen/qwen3.5-flash-02-23",
    "MAX_DAILY_AI_RUNS": "10",
    "BETTER_AUTH_URL": "https://outperform.buttercoder-dev.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "outperform-prod",
      "database_id": "cb25ae38-f5bc-4e96-8ea2-b049456b5187",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "outperform-artifacts-prod"
    }
  ],
  "workflows": [
    {
      "name": "outperform-improvement",
      "binding": "OUTPERFORM_WORKFLOW",
      "class_name": "ImprovementWorkflow"
    }
  ],
  "observability": { "enabled": true },
  "env": {
    "dev": {
      "name": "outperform-dev",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "outperform-dev",
          "database_id": "a6db567d-78eb-4a8d-a51c-ffa0571814a2",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ARTIFACTS",
          "bucket_name": "outperform-artifacts-dev"
        }
      ],
      "workflows": [
        {
          "name": "outperform-improvement-dev",
          "binding": "OUTPERFORM_WORKFLOW",
          "class_name": "ImprovementWorkflow"
        }
      ]
    }
  }
}